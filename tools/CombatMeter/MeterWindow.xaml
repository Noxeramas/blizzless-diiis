<Window x:Class="D3Offline.CombatMeter.MeterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="D3Offline Combat Meter" Width="470" Height="650" MinWidth="360" MinHeight="380"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" AllowsTransparency="True"
        Background="Transparent" Foreground="#EEEDE8" Topmost="True" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13" ShowActivated="False">
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="Background" Value="#33363F"/><Setter Property="Foreground" Value="#F4F2EA"/><Setter Property="Padding" Value="9,5"/><Setter Property="Margin" Value="3"/><Setter Property="BorderBrush" Value="#535761"/></Style>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="#B5B8C0"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style TargetType="Separator"><Setter Property="Background" Value="#444852"/><Setter Property="Margin" Value="0,10"/></Style>
  </Window.Resources>
  <Border Background="#F51B1D23" BorderBrush="#5F626B" BorderThickness="1" CornerRadius="10" Padding="14">
    <DockPanel LastChildFill="True">
      <StackPanel DockPanel.Dock="Top">
        <Grid MouseLeftButtonDown="DragHeader">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="Combat meter" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="F8 show / hide · Drag here to move" Style="{StaticResource Muted}"/></StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Hide" Click="HideMeter"/><Button Content="×" ToolTip="Close the meter" Click="CloseMeter"/></StackPanel>
        </Grid>
        <TextBlock x:Name="ConnectionText" Text="Connecting to local server…" Foreground="#DEB66F" Margin="0,8,0,6"/>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
          <ComboBox x:Name="PlayerPicker" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="SelectionChanged" Margin="0,0,8,0"/>
          <ComboBox x:Name="DirectionPicker" Grid.Column="1" SelectedIndex="0" SelectionChanged="SelectionChanged"><ComboBoxItem Content="Outgoing"/><ComboBoxItem Content="Incoming"/></ComboBox>
        </Grid>
        <Grid Margin="0,12,0,3">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="DPS · trailing 3 seconds" Style="{StaticResource Muted}"/><TextBlock x:Name="DpsText" Text="0" FontSize="30" FontWeight="SemiBold"/><TextBlock x:Name="AverageText" Text="Encounter average 0" Style="{StaticResource Muted}"/></StackPanel>
          <StackPanel Grid.Column="1"><TextBlock Text="Health removed" Style="{StaticResource Muted}"/><TextBlock x:Name="TotalText" Text="0" FontSize="25"/><TextBlock x:Name="CountText" Text="0 hits" Style="{StaticResource Muted}"/></StackPanel>
        </Grid>
        <Canvas x:Name="ChartCanvas" Height="105" Margin="0,7" SizeChanged="ChartSizeChanged" ClipToBounds="True"/>
        <DockPanel><Button Content="Reset encounter" Click="ResetEncounter" DockPanel.Dock="Right"/><TextBlock Text="Actual HP loss · absorbs and overkill excluded" Style="{StaticResource Muted}" VerticalAlignment="Center"/></DockPanel>
        <Separator/>
      </StackPanel>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <TextBlock x:Name="BuffTitle" Text="Buffs and effects" FontWeight="SemiBold"/>
          <ItemsControl x:Name="BuffRows">
            <ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}"/><TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="#DEB66F" Margin="8,0,0,0"/></Grid></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock x:Name="ShieldText" Style="{StaticResource Muted}" Margin="0,4"/>
          <Separator/>
          <TextBlock x:Name="HitTitle" Text="Waiting for combat…" FontWeight="SemiBold"/>
          <TextBlock x:Name="FactorTotal" Style="{StaticResource Muted}" Margin="0,5"/>
          <ItemsControl x:Name="FactorRows">
            <ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}"/><TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Value}" Margin="8,0,0,0"/></Grid></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <Expander x:Name="Details" Header="Inspect hit · buckets and damage steps" Foreground="#EEEDE8" Margin="0,10" Expanded="ExpandDetails">
            <StackPanel Margin="0,10">
              <CheckBox x:Name="FollowLatest" Content="Follow latest hit" IsChecked="True" Foreground="#EEEDE8" Checked="FollowChanged" Unchecked="FollowChanged"/>
              <Slider x:Name="HitSlider" Minimum="0" Maximum="0" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="HitChanged" Margin="0,8"/>
              <TextBlock x:Name="HitMeta" Style="{StaticResource Muted}"/>
              <TextBlock Text="Recorded calculation" FontWeight="SemiBold" Margin="0,12,0,4"/>
              <ItemsControl x:Name="StepRows"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}"/><TextBlock Grid.Column="1" Text="{Binding Value}" Margin="8,0,0,0"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              <TextBlock Text="Reference bucket comparison · partial coverage" FontWeight="SemiBold" Margin="0,14,0,4"/>
              <TextBlock x:Name="ReferenceText" Foreground="#DEB66F"/>
              <TextBlock Text="Published D3 bucket rules; current-client live parity is still unverified. Weapon totals may already contain buffs. Unclassified factors are excluded from this comparison." Style="{StaticResource Muted}" Margin="0,7"/>
              <ItemsControl x:Name="BucketRows"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,4"><TextBlock Text="{Binding Name}"/><TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel>
          </Expander>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</Window>
